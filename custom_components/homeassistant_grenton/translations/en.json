  "services": {
    "run_scene": {
      "name": "Run scene",
      "description": "Run a configured Grenton scene action, optionally overriding its arguments/value for one call.",
      "fields": {
        "parameter": {
          "name": "Parameter",
          "description": "Omit to use the saved arguments/value. For scripts, use Lua arguments (\"abc\", 42, or 42, \"abc\"); for other call types, enter the string value without surrounding quotes. An explicitly empty string clears the arguments/value for this call. Use either parameter or typed arguments."
        },
        "arguments": {
          "name": "Typed arguments",
          "description": "Script/method arguments with types. Add, edit, delete, or reorder rows. Omit to use saved arguments; an empty list calls without arguments. Use either parameter or arguments."
        }
      }
    }
