        "data": {
          "entity_type": "Entity type",
          "state": "State source"
        }
      },
      "configure_on_off_on_action": {
        "title": "Configure {entity_name} - Turn on (2/3)",
        "description": "Choose the call type and configure the turn-on target, value or arguments.",
        "data": {
          "action_on": "Turn on action"
        }
      },
      "configure_on_off_off_action": {
        "title": "Configure {entity_name} - Turn off (3/3)",
        "description": "Choose the call type and configure the turn-off target, value or arguments. Saving reloads the integration and applies all three forms.",
        "data": {
          "action_off": "Turn off action"
        }
      },
      "clu_variables": {
        "title": "Configure {clu_name} variables",
        "description": "Add, edit, or remove custom CLU variables exposed in Home Assistant.",
        "data": {
          "operation": "Operation"
        }
      },
      "clu_variable_select": {
        "title": "Edit a CLU variable",
        "description": "Select the variable to configure.",
        "data": {
          "variable_id": "Variable"
        }
      },
      "clu_variable_remove": {
        "title": "Remove a CLU variable entity",
        "description": "Remove the selected variable from Home Assistant. Its value on the CLU is kept.",
        "data": {
          "variable_id": "Variable"
        }
      },
      "configure_clu_variable": {
        "title": "Configure a CLU variable",
        "description": "Enter the variable name exactly as defined in Grenton and select its value type. Boolean variables become switches; other types become sensors.",
        "data": {
          "variable_name": "Variable name",
          "label": "Display name",
          "grenton_type": "Grenton type"
        }
      }
    },
    "abort": {
      "no_configurable_entities": "No configurable entities found.",
      "entity_not_found": "Selected entity not found.",
      "entity_not_configurable": "This entity cannot be configured.",
      "device_not_found": "Selected Grenton device was not found."
    },
    "error": {
      "invalid_configuration": "Select valid options and enter valid values."
    }
